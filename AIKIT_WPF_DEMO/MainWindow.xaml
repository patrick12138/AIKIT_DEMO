<Window x:Class="AikitWpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIKIT 统一语音交互演示" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态栏 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtStatus" Text="系统状态: 未初始化" 
                          Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="Gray" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtVoiceState" Text="待机" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 控制面板 -->
        <Border Grid.Row="1" Background="#F8F9FA" Padding="20" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 参数设置 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="唤醒阈值:" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtWakeupThreshold" Text="50" Width="60" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock Text="命令超时(秒):" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtCommandTimeout" Text="10" Width="60" Margin="0,0,20,0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 主要控制按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnStartVoice" Content="🎤 开始语音交互" Width="140" Height="35" 
                           Margin="5" Click="BtnStartVoice_Click" 
                           Background="#28A745" Foreground="White" FontSize="12"/>
                    <Button x:Name="BtnStopVoice" Content="⏹️ 停止语音交互" Width="140" Height="35" 
                           Margin="5" Click="BtnStopVoice_Click" 
                           Background="#DC3545" Foreground="White" FontSize="12" IsEnabled="False"/>
                    <Button x:Name="BtnClearLog" Content="🗑️ 清空日志" Width="100" Height="35" 
                           Margin="5" Click="BtnClearLog_Click" 
                           Background="#6C757D" Foreground="White" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日志显示区 -->
        <Border Grid.Row="2" Margin="20" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="#495057" Padding="10" CornerRadius="5,5,0,0">
                    <TextBlock Text="📋 语音交互日志" Foreground="White" FontWeight="Bold"/>
                </Border>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                    <TextBlock x:Name="TxtLog" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                              Foreground="#212529" LineHeight="16"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部信息栏 -->
        <Border Grid.Row="3" Background="#6C757D" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡 说话前请先说唤醒词，然后等待提示音后说出命令" 
                          Foreground="White" FontSize="11"/>
                <TextBlock Grid.Column="1" x:Name="TxtVersion" Text="v1.0.0" 
                          Foreground="#ADB5BD" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</Window>